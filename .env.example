NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:4200

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

AWS_ENDPOINT_URL_S3=https://example-object-storage.invalid
AWS_ACCESS_KEY_ID=replace-with-access-key
AWS_SECRET_ACCESS_KEY=replace-with-secret-key
AWS_REGION=eu-west-1
AWS_BUCKET_NAME=replace-with-bucket-name

JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=7d

GOOGLE_CLIENT_IDS=replace-with-google-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret

# Configure uniquement côté backend. Remplacez les valeurs avant activation.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=votre.adresse@gmail.com
SMTP_PASSWORD=remplacer-par-un-nouveau-mot-de-passe-application
SMTP_FROM="CloseIA <votre.adresse@gmail.com>"
FRONTEND_URL=http://localhost:4200
MOBILE_APP_URL=https://play.google.com/store/apps/details?id=com.closeia.mobile

SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-secure-seed-password
SEED_ADMIN_RESET_PASSWORD=false
